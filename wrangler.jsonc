{
  // Cloudflare Workers + Static Assets deployment config for https://ainvtry.com
  "name": "ainventory",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_UPSTREAM_ORIGIN": "https://ainventory-api.onrender.com",
    "NEWSLETTER_NOTIFY_EMAIL": "raymond@ainvtry.com"
  }
}
