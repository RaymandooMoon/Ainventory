# Server Configuration
PORT=3000
HOST=0.0.0.0
ALLOW_PREVIEW_IFRAME=1
ALLOW_MOCK_APPLE_AUTH=true
ALLOW_DEV_OTP_PREVIEW=true
SEED_DEMO_DATA=true
AINVENTORY_DB_PATH=
FORCE_SQLJS=
ADMIN_INITIAL_PASSWORD=
# Secret password for the dedicated read-only 'site_demo' account (store in Secrets; never commit or expose to client)
SITE_DEMO_PASSWORD=
# Comma-separated explicit origins allowed to call /api cross-origin (e.g. https://raymandoomoon.github.io)
CORS_ALLOWED_ORIGINS=

# Gemini / Vertex AI (Server-Side)
GEMINI_API_KEY=
GEMINI_VTON_MODEL=
# Optional Nano Banana 2.1 4x2 8-angle turnaround sheet resolution: 1K | 2K (default) | 4K
GEMINI_VTON_SHEET_IMAGE_SIZE=2K
# Optional Nano Banana 2.1 spatial reasoning thinking level: MINIMAL | LOW | MEDIUM | HIGH (default) | OFF
GEMINI_VTON_THINKING_LEVEL=HIGH
# Optional max QC retries for 4x2 turnaround sheet (default 1 = single-shot cost cap)
GEMINI_VTON_SHEET_MAX_QC_ATTEMPTS=1
VERTEX_AI_ENDPOINT=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ACCESS_TOKEN=
VERTEX_AI_API_KEY=

# OAuth & Identity Providers
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_PUBLIC_KEY_PEM=

# Client Build / Runtime Variables
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_BG_REMOVAL_API_URL=
VITE_BG_REMOVAL_API_KEY=
VITE_VTON_API_URL=
VITE_NEWSLETTER_ENDPOINT=
VITE_STATIC_STANDALONE=
# Optional Quixel Megascans CDN/base URL (defaults to local /assets/megascans when synced via npm run megascans:sync)
VITE_MEGASCANS_BASE_URL=

# Google Maps Platform (Server Proxy & Maps JS API)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Newsletter Verification & Notifications (Resend OTP/Welcome/Founder Emails & Optional Webhook)
RESEND_API_KEY=
RESEND_FROM_EMAIL=iNVTRY <newsletter@ainvtry.com>
NEWSLETTER_NOTIFY_EMAIL=raymond@ainvtry.com
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_SYNC_SECRET=
API_UPSTREAM_ORIGIN=https://ainventory-api.onrender.com
