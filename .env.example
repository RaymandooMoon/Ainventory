# Local Development Environment Variables (Copy to `.env.local` — never commit real keys!)
# Note: GitHub Actions Secrets (`VITE_GEMINI_API_KEY`) are NOT downloaded by `git pull`.
# For `http://localhost:5173`, either paste your key in the UI `[키 설정]` button
# OR copy this file to `.env.local` and set your Google AI Studio Gemini API key below:

GEMINI_API_KEY=
# VITE_GEMINI_API_KEY=
