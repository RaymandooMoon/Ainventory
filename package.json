{
  "name": "ainventory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "dev:app": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "start": "node server/start.js",
    "lint": "oxlint src server tests",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.site.config.ts",
    "cap:sync": "vite build && cap sync android",
    "test:unit": "node --experimental-strip-types --test 'tests/unit/**/*.test.ts'",
    "test:api": "node --experimental-strip-types --test 'tests/api/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:api",
    "test:e2e": "playwright test",
    "verify:console": "node .agent/hooks/check-console-log.mjs --all",
    "verify:docs": "node .agent/hooks/check-doc-hygiene.mjs",
    "verify:stitch-skills": "node .agent/hooks/verify-stitch-skills.mjs",
    "verify:secrets": "node .agent/hooks/pre-commit-quality.mjs --secrets-only",
    "verify:staged": "node .agent/hooks/pre-commit-quality.mjs",
    "verify:quick": "npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "ir:sync": "node --experimental-strip-types scripts/sync-ir-deck.mjs",
    "ir:sync:check": "node --experimental-strip-types scripts/sync-ir-deck.mjs --check",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/* .agent/hooks/*.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@google/genai": "^3.6.1",
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vis.gl/react-google-maps": "^1.10.2",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
